# RivetLink Relay Server — Environment Variables
# Copy this to .env and adjust values for your environment.

# Required
DATABASE_URL=postgres://rivet:rivet_dev@localhost/rivet
JWT_SECRET=change-this-to-a-random-32-character-secret

# Optional (shown with defaults)
REDIS_URL=redis://127.0.0.1:6379
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info

# Token lifetimes (seconds)
ACCESS_TOKEN_EXPIRY_SECS=900       # 15 minutes
REFRESH_TOKEN_EXPIRY_SECS=604800   # 7 days

# Login security
MAX_FAILED_LOGINS=5
LOCKOUT_DURATION_SECS=900          # 15 minutes

# WebSocket
HEARTBEAT_INTERVAL_SECS=10
DISCONNECT_TIMEOUT_SECS=30
RECONNECT_GRACE_SECS=15
