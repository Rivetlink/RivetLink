# Editor defaults for RivetLink (Rust workspace). Rust uses 4-space indent
# (rustfmt convention); other config files match.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4

[*.{toml,json,yml,yaml}]
indent_style = space
indent_size = 2
